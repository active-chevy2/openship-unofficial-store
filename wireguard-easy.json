{
  "$schema": "https://openship.io/app.schema.json",
  "available": true,
  "id": "wg-easy",
  "name": "wg-easy",
  "description": "The easiest way to run WireGuard VPN + Web-based Admin UI.",
  "kind": "template",
  "logo": "wireguard",
  "category": "other",
  "tags": [
    "wireguard",
    "vpn",
    "web",
    "admin"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "wg-easy",
      "image": "ghcr.io/wg-easy/wg-easy:latest",
      "exposedPort": 8000,
      "exposed": true,
      "environment": {
        "WG_HOST": "{{publicUrl:wg-easy}}",
        "LANG": "en",
        "WG_PORT": "51820"
      },
      "secretEnv": [
        "PASSWORD"
      ],
      "volumes": [
        "wg_easy_data:/etc/wireguard"
      ],
      "ports": [
        "51820:51820/udp"
      ],
      "capAdd": [
        "NET_ADMIN",
        "SYS_MODULE"
      ],
      "sysctls": {
        "net.ipv4.conf.all.src_valid_mark": 1,
        "net.ipv4.ip_forward": 1
      },
      "entrypoint": [
        "/bin/bash",
        "-c",
        "eval \"wgpw '$PASSWORD' > /pass-hash\"\neval \"$(cat /pass-hash) dumb-init node server.js\""
      ],
      "restart": "unless-stopped"
    }
  ],
  "configFields": [
    {
      "service": "wg-easy",
      "key": "PASSWORD",
      "label": "Admin Web UI Password",
      "generate": "secret",
      "secret": true
    }
  ],
  "connection": {
    "title": "Set up WireGuard",
    "description": "Your WireGuard VPN and Admin UI are ready.",
    "guide": {
      "defaultMode": "public"
    },
    "outputs": [
      {
        "id": "url",
        "label": "Open Admin UI",
        "source": "publicUrl:wg-easy",
        "kind": "url",
        "recommended": true
      },
      {
        "id": "password",
        "label": "Admin password",
        "source": "env:wg-easy:PASSWORD",
        "secret": true,
        "width": "half"
      }
    ]
  },
  "verified": true,
  "marketplace": {
    "features": [
      {
        "title": "WireGuard VPN",
        "description": "Fast, modern, secure VPN tunnel."
      },
      {
        "title": "Web Admin UI",
        "description": "Easily manage your clients and download config files."
      }
    ]
  }
}