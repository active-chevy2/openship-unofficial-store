{
  "$schema": "https://openship.io/app.schema.json",
  "available": true,
  "id": "onetimesecret",
  "name": "Onetime Secret",
  "description": "Share sensitive information securely with self-destructing links that are only viewable once.",
  "kind": "template",
  "logo": "onetimesecret",
  "category": "other",
  "tags": [
    "auth",
    "password",
    "secret",
    "secure"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "redis",
      "image": "redis:8-alpine",
      "volumes": [
        "onetimesecret_redis_data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3
      },
      "restart": "unless-stopped"
    },
    {
      "name": "onetimesecret",
      "image": "onetimesecret/onetimesecret:latest",
      "exposedPort": 3000,
      "exposed": true,
      "dependsOn": [
        "redis"
      ],
      "environment": {
        "AUTH_AUTOVERIFY": "true",
        "AUTH_SIGNUP": "true",
        "HOST": "localhost:3000",
        "REDIS_URL": "redis://redis:6379/0",
        "SSL": "false",
        "RACK_ENV": "production"
      },
      "secretEnv": [
        "SECRET"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "ruby",
          "-rnet/http",
          "-e",
          "exit(Net::HTTP.get_response(URI('http://localhost:3000')).is_a?(Net::HTTPSuccess) ? 0 : 1)"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3
      },
      "restart": "unless-stopped"
    }
  ],
  "configFields": [
    {
      "service": "onetimesecret",
      "key": "SECRET",
      "label": "Encryption Secret",
      "help": "Root 32+ character key used to encrypt all stored secrets.",
      "generate": "secret",
      "secret": true
    },
    {
      "service": "onetimesecret",
      "key": "COLONEL",
      "label": "Colonel Admin Email",
      "help": "Primary administrator contact email for the instance.",
      "type": "text",
      "default": "admin@example.com",
      "required": true
    },
    {
      "service": "onetimesecret",
      "key": "HOST",
      "label": "Host Domain / FQDN",
      "help": "Your domain without protocol (e.g. secret.example.com or localhost:3000) used for link generation.",
      "type": "text",
      "default": "localhost:3000",
      "required": true
    }
  ],
  "connection": {
    "title": "Open Onetime Secret",
    "description": "Your self-hosted secret-sharing service is ready.",
    "guide": {
      "defaultMode": "public"
    },
    "outputs": [
      {
        "id": "url",
        "label": "Open Onetime Secret",
        "source": "publicUrl:onetimesecret",
        "kind": "url",
        "recommended": true
      },
      {
        "id": "admin_email",
        "label": "Colonel Admin Email",
        "source": "env:onetimesecret:COLONEL",
        "width": "half"
      }
    ],
    "firstLogin": {
      "note": "To provision your initial Colonel administrator account via CLI, run inside the container terminal: bin/ots customers create <your-email> --role colonel"
    }
  },
  "verified": true,
  "marketplace": {
    "features": [
      {
        "title": "Self-Destructing Secrets",
        "description": "Generate single-use links that expire automatically once viewed."
      },
      {
        "title": "Encrypted at Rest",
        "description": "Secrets and metadata are encrypted in Redis with your generated root key."
      }
    ]
  }
}