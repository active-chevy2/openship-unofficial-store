{
  "$schema": "https://openship.io/app.schema.json",
  "available": true,
  "id": "hedgedoc",
  "name": "HedgeDoc",
  "description": "Collaborative markdown notes, scratchpads, and documentation platform.",
  "kind": "template",
  "logo": "hedgedoc",
  "category": "other",
  "tags": [
    "markdown",
    "notes",
    "collaboration",
    "wiki",
    "docs"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "database",
      "image": "postgres:17.7-alpine",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_USER": "hedgedoc",
        "POSTGRES_DB": "hedgedoc"
      },
      "secretEnv": [
        "POSTGRES_PASSWORD"
      ],
      "volumes": [
        "hedgedoc_database:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U hedgedoc -d hedgedoc"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    {
      "name": "hedgedoc",
      "image": "quay.io/hedgedoc/hedgedoc:1.10.8",
      "exposedPort": 3000,
      "exposed": true,
      "dependsOn": [
        "database"
      ],
      "environment": {
        "CMD_PROTOCOL_USESSL": "true",
        "CMD_URL_ADDPORT": "false",
        "CMD_DB_DIALECT": "postgres",
        "CMD_DB_HOST": "database",
        "CMD_DB_PORT": "5432",
        "CMD_DB_USERNAME": "hedgedoc",
        "CMD_DB_DATABASE": "hedgedoc"
      },
      "secretEnv": [
        "CMD_DB_PASSWORD"
      ],
      "volumes": [
        "hedgedoc_uploads:/hedgedoc/public/uploads"
      ],
      "restart": "unless-stopped"
    }
  ],
  "configFields": [
    {
      "service": "hedgedoc",
      "key": "CMD_DOMAIN",
      "label": "Domain / Hostname",
      "help": "CRITICAL: Enter only the bare domain or subdomain without 'https://' or trailing slashes (e.g. md.example.com). Including a protocol will break CSS and JavaScript asset loading.",
      "placeholder": "md.yourdomain.com",
      "type": "text",
      "required": true
    },
    {
      "service": "database",
      "key": "POSTGRES_PASSWORD",
      "label": "Database Password",
      "generate": "secret",
      "secret": true,
      "generateGroup": "hedgedoc-db"
    },
    {
      "service": "hedgedoc",
      "key": "CMD_DB_PASSWORD",
      "label": "HedgeDoc Database Password",
      "generate": "secret",
      "secret": true,
      "generateGroup": "hedgedoc-db"
    }
  ],
  "connection": {
    "title": "Set up HedgeDoc",
    "description": "Your collaborative markdown workspace is ready.",
    "guide": {
      "defaultMode": "public"
    },
    "outputs": [
      {
        "id": "url",
        "label": "Open HedgeDoc",
        "source": "publicUrl:hedgedoc",
        "kind": "url",
        "recommended": true
      },
      {
        "id": "domain",
        "label": "Configured Domain",
        "source": "env:hedgedoc:CMD_DOMAIN",
        "width": "half"
      }
    ],
    "firstLogin": {
      "note": "CONFIGURATION NOTICE: Verify that 'CMD_DOMAIN' matches your exact domain without any 'https://' prefix. If the web UI ever loads as plain unstyled text, check that CMD_DOMAIN does not contain a protocol prefix."
    }
  },
  "verified": true,
  "marketplace": {
    "features": [
      {
        "title": "Collaborative Markdown",
        "description": "Write, edit, and share notes simultaneously in real-time."
      },
      {
        "title": "Persistent Storage",
        "description": "Uploads and database records are securely retained across updates in named volumes."
      }
    ]
  }
}