{
  "$schema": "https://openship.io/app.schema.json",
  "available": true,
  "id": "ntfy",
  "name": "ntfy",
  "description": "A simple HTTP-based pub-sub notification service to send alerts to phone or desktop via scripts or REST API.",
  "kind": "template",
  "logo": "ntfy",
  "category": "other",
  "tags": [
    "ntfy",
    "notification",
    "push-notification",
    "pub-sub",
    "notify"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "ntfy",
      "image": "binwiederhier/ntfy:latest",
      "exposedPort": 80,
      "exposed": true,
      "commandArgv": [
        "serve"
      ],
      "environment": {
        "NTFY_BASE_URL": "{{publicUrl:ntfy}}",
        "TZ": "Asia/Kuching",
        "NTFY_CACHE_FILE": "/var/cache/ntfy/cache.db",
        "NTFY_AUTH_FILE": "/var/lib/ntfy/auth.db",
        "NTFY_WEB_PUSH_FILE": "/var/cache/ntfy/webpush.db",
        "NTFY_BEHIND_PROXY": "true",
        "NTFY_UPSTREAM_BASE_URL": "https://ntfy.sh",
        "NTFY_ENABLE_SIGNUP": "true",
        "NTFY_ENABLE_LOGIN": "true",
        "NTFY_CACHE_DURATION": "24h",
        "NTFY_ATTACHMENT_TOTAL_SIZE_LIMIT": "1G",
        "NTFY_ATTACHMENT_FILE_SIZE_LIMIT": "10M",
        "NTFY_ATTACHMENT_EXPIRY_DURATION": "24h",
        "NTFY_KEEPALIVE_INTERVAL": "5m",
        "NTFY_MANAGER_INTERVAL": "5m",
        "NTFY_VISITOR_MESSAGE_DAILY_LIMIT": "100",
        "NTFY_VISITOR_ATTACHMENT_DAILY_BANDWIDTH_LIMIT": "1G",
        "NTFY_AUTH_DEFAULT_ACCESS": "read-write"
      },
      "volumes": [
        "ntfy_cache:/var/cache/ntfy",
        "ntfy_db:/var/lib/ntfy"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -q --tries=1 http://localhost:80/v1/health -O - | grep -Eo '\"healthy\"\\s*:\\s*true' || exit 1"
        ],
        "interval": "60s",
        "timeout": "10s",
        "retries": 3,
        "startPeriod": "40s"
      },
      "restart": "unless-stopped"
    }
  ],
  "connection": {
    "title": "Open ntfy",
    "description": "Your self-hosted notification server is ready to send and receive alerts.",
    "guide": {
      "defaultMode": "public"
    },
    "outputs": [
      {
        "id": "url",
        "label": "Open ntfy",
        "source": "publicUrl:ntfy",
        "kind": "url",
        "recommended": true
      }
    ],
    "firstLogin": {
      "note": "Open the web interface to test publishing topics. You can publish directly from any terminal using `curl -d 'Hello' {{publicUrl:ntfy}}/mytopic`."
    }
  },
  "verified": true,
  "marketplace": {
    "features": [
      {
        "title": "HTTP Pub-Sub",
        "description": "Send push notifications from scripts, curl, or REST APIs to desktop and mobile."
      },
      {
        "title": "Persistent State",
        "description": "Caches, accounts, and attachments are retained across restarts in named volumes."
      }
    ]
  }
}